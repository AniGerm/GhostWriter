#!/bin/sh
# CUPS backend: GhostWriter virtual printer
# argv: backend job-id user title copies options [file]
set -eu

BACKEND_NAME="ghostwriter"
SPOOL_ROOT="/var/spool/ghostwriter"

if [ $# -eq 0 ]; then
  echo "direct ${BACKEND_NAME} \"Unknown\" \"GhostWriter (virtuell)\""
  exit 0
fi

JOB_ID="${1:-}"
USER_NAME="${2:-unknown}"
TITLE="${3:-document}"
# copies=$4 options=$5
INPUT_FILE="${6:-}"

USER_SAFE=$(printf '%s' "$USER_NAME" | tr -cd 'A-Za-z0-9._-')
[ -n "$USER_SAFE" ] || USER_SAFE="user"
DEST_DIR="${SPOOL_ROOT}/${USER_SAFE}"
mkdir -p "$DEST_DIR"

# Spool-Ordner muss dem Desktop-User gehören (sonst kann GhostWriter nicht lesen)
if id "$USER_NAME" >/dev/null 2>&1; then
  chown "$USER_NAME":"$USER_NAME" "$DEST_DIR" 2>/dev/null || true
  chmod 755 "$DEST_DIR" 2>/dev/null || true
fi

STAMP=$(date +%Y%m%d_%H%M%S)
SAFE_TITLE=$(printf '%s' "$TITLE" | tr -cd 'A-Za-z0-9._-' | cut -c1-40)
[ -n "$SAFE_TITLE" ] || SAFE_TITLE="job"
OUT="${DEST_DIR}/${STAMP}_${JOB_ID}_${SAFE_TITLE}.pdf"

if [ -n "$INPUT_FILE" ] && [ -f "$INPUT_FILE" ]; then
  cat "$INPUT_FILE" >"$OUT"
else
  cat >"$OUT"
fi

# Best-effort ownership for the desktop user
if id "$USER_NAME" >/dev/null 2>&1; then
  chown "$USER_NAME":"$USER_NAME" "$OUT" 2>/dev/null || true
  chmod 600 "$OUT" 2>/dev/null || true
fi

exit 0
