#!/bin/bash
set -euo pipefail

APP_ROOT=/opt/ghostwriter
VENV="${APP_ROOT}/venv"

python3 -m venv "${VENV}"
"${VENV}/bin/pip" install --upgrade pip
"${VENV}/bin/pip" install "${APP_ROOT}"

# OCR-Stack: paddlepaddle-gpu liegt nicht auf PyPI, sondern im Paddle-Index.
# Ohne Index schlägt die Installation fehl und Scans brechen später mit
# "No module named 'paddleocr'" ab. Fehler hier sichtbar machen, Deb trotzdem
# weiterinstallieren (Text-PDFs funktionieren auch ohne OCR).
OCR_LOG=/var/log/ghostwriter-ocr-install.log
if ! "${VENV}/bin/pip" install "paddlepaddle-gpu==3.2.1" \
  -i https://www.paddlepaddle.org.cn/packages/stable/cu129/ \
  >"${OCR_LOG}" 2>&1; then
  echo "WARNUNG: paddlepaddle-gpu konnte nicht installiert werden. Details: ${OCR_LOG}" >&2
elif ! "${VENV}/bin/pip" install -U "paddleocr[doc-parser]>=3.6.0" \
  >>"${OCR_LOG}" 2>&1; then
  echo "WARNUNG: paddleocr konnte nicht installiert werden. Details: ${OCR_LOG}" >&2
elif ! "${VENV}/bin/python" -c "import paddleocr" >/dev/null 2>&1; then
  echo "WARNUNG: paddleocr ist nach der Installation nicht importierbar. Details: ${OCR_LOG}" >&2
else
  echo "OCR-Stack (paddlepaddle-gpu + paddleocr) installiert."
fi

install -d -m 0755 /usr/lib/ghostwriter
install -m 0755 "${APP_ROOT}/packaging/apply-update.sh" /usr/lib/ghostwriter/apply-update.sh
install -m 0755 "${APP_ROOT}/packaging/cups/install-printer.sh" /usr/lib/ghostwriter/install-printer.sh
install -m 0644 "${APP_ROOT}/packaging/polkit/com.ghostwriter.apply-update.policy" \
  /usr/share/polkit-1/actions/com.ghostwriter.apply-update.policy

# Virtueller Drucker (Backend + CUPS-Queue) – verpflichtend für Befund-Import
if ! /usr/lib/ghostwriter/install-printer.sh \
  "${APP_ROOT}/packaging/cups/ghostwriter" \
  "${APP_ROOT}/packaging/cups/GhostWriter.ppd"; then
  echo "FEHLER: GhostWriter-Drucker konnte nicht eingerichtet werden." >&2
  echo "Bitte CUPS starten und erneut ausführen:" >&2
  echo "  sudo systemctl start cups" >&2
  echo "  sudo /usr/lib/ghostwriter/install-printer.sh" >&2
  exit 1
fi

# App-Icon für Ubuntu/GNOME-Suche (hicolor + pixmaps)
install -d -m 0755 /usr/share/icons/hicolor/scalable/apps
install -m 0644 "${APP_ROOT}/packaging/icons/ghostwriter.svg" \
  /usr/share/icons/hicolor/scalable/apps/ghostwriter.svg
for size in 16 24 32 48 64 128 256 512; do
  install -d -m 0755 "/usr/share/icons/hicolor/${size}x${size}/apps"
  install -m 0644 "${APP_ROOT}/packaging/icons/${size}x${size}/ghostwriter.png" \
    "/usr/share/icons/hicolor/${size}x${size}/apps/ghostwriter.png"
done
install -d -m 0755 /usr/share/pixmaps
install -m 0644 "${APP_ROOT}/packaging/icons/256x256/ghostwriter.png" \
  /usr/share/pixmaps/ghostwriter.png

install -m 0755 "${APP_ROOT}/scripts/ghostwriter-launch.sh" /usr/bin/ghostwriter
ln -sfn /usr/bin/ghostwriter /usr/local/bin/ghostwriter 2>/dev/null || true

# Leichte Electron-Runtime für Dock-Fenster mit App-Icon (best effort)
if command -v npm >/dev/null 2>&1; then
  (
    cd "${APP_ROOT}"
    npm init -y >/dev/null 2>&1 || true
    npm install --omit=dev electron@37 >/dev/null 2>&1 || true
  ) || true
fi

install -m 0644 "${APP_ROOT}/packaging/ghostwriter.desktop" /usr/share/applications/ghostwriter.desktop
install -m 0644 "${APP_ROOT}/packaging/ghostwriter-autostart.desktop" /etc/xdg/autostart/ghostwriter.desktop

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

ldconfig || true
echo "GhostWriter installiert. Start: ghostwriter-web  | Drucker: GhostWriter"
